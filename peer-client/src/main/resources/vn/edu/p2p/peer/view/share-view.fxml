<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.p2p.peer.share.ShareController"
      spacing="12"
      styleClass="login-root">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="CHIA SẺ TỆP" styleClass="title"/>

    <HBox spacing="10">
        <Button fx:id="chooseFileButton"
                text="Chia sẻ tệp"
                onAction="#onChooseFile"/>


        <Button fx:id="chooseFolderButton"
                text="Chia sẻ thư mục"
                onAction="#onShareFolder"/>
    </HBox>

    <Label fx:id="selectedFileLabel"
           text="Chưa chọn tệp nào"
           wrapText="true"
           maxWidth="Infinity"/>

    <TabPane VBox.vgrow="ALWAYS" minHeight="140" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Đang chia sẻ">
                <VBox spacing="10">
                    <ListView fx:id="sharedFilesListView" minHeight="100" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Button fx:id="previousSharePage" text="Trước"/>
                        <HBox fx:id="sharePageNumbers" spacing="4"/>
                        <Button fx:id="nextSharePage" text="Sau"/>
                        <Label fx:id="sharePageLabel" text="Trang 1"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Lịch sử chia sẻ">
                <VBox spacing="10">
                    <Label text="Các lượt chia sẻ thành công trên thiết bị này" wrapText="true"/>
                    <VBox fx:id="shareHistoryFilterHost"/>
                    <TreeView fx:id="shareHistoryView" minHeight="100" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Button fx:id="previousHistoryPage" text="Trước"/>
                        <HBox fx:id="historyPageNumbers" spacing="4"/>
                        <Button fx:id="nextHistoryPage" text="Sau"/>
                        <Label fx:id="historyPageLabel" text="Trang 1"/>
                    </HBox>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
    <Label fx:id="statusLabel"
           wrapText="true"
           maxWidth="Infinity"
           styleClass="status"/>
</VBox>
