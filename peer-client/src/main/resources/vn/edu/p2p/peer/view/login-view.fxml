<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.edu.p2p.peer.auth.LoginController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: #101827; -fx-background: #101827;">
    <content>
        <VBox alignment="CENTER" spacing="12" styleClass="login-root">
    <padding>
        <Insets top="26" right="42" bottom="26" left="42"/>
    </padding>

    <Label text="P2P FILE SHARING" styleClass="title"/>
    <Label fx:id="authModeLabel" text="Đăng nhập vào Tracker" styleClass="subtitle"/>

    <!-- Two independent credential forms. Only the active form is visible/managed. -->
    <VBox fx:id="loginForm" spacing="12" alignment="CENTER">
        <TextField fx:id="usernameField" promptText="Tên đăng nhập" maxWidth="320"/>
        <PasswordField fx:id="passwordField" promptText="Mật khẩu" maxWidth="320"/>
        <Button fx:id="loginButton" text="ĐĂNG NHẬP" onAction="#onLogin"
                defaultButton="true" prefWidth="320"/>
        <Button fx:id="showRegisterButton" text="Chưa có tài khoản? Đăng ký"
                style="-fx-background-color: transparent; -fx-text-fill: #5eead4;"
                prefWidth="320" onAction="#onShowRegisterForm"/>
    </VBox>

    <VBox fx:id="registrationForm" visible="false" managed="false"
          spacing="12" alignment="CENTER">
        <TextField fx:id="registerUsernameField" promptText="Tên tài khoản mới" maxWidth="320"/>
        <PasswordField fx:id="registerPasswordField" promptText="Mật khẩu mới" maxWidth="320"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu" maxWidth="320"/>
        <Button fx:id="registerButton" text="TẠO TÀI KHOẢN" prefWidth="320"
                onAction="#onRegister"/>
        <Button fx:id="showLoginButton" text="Đã có tài khoản? Đăng nhập"
                style="-fx-background-color: transparent; -fx-text-fill: #5eead4;"
                prefWidth="320" onAction="#onShowLoginForm"/>
    </VBox>

    <Button fx:id="openDashboardButton" text="Mở Peer Center" disable="true"
            onAction="#onOpenDashboard"/>

    <Label fx:id="statusLabel" wrapText="true" maxWidth="330" styleClass="status"/>
    <Label fx:id="connectionStatusLabel" wrapText="true"
           maxWidth="330" styleClass="status"/>

    <!-- Technical settings stay accessible for troubleshooting, not in daily login. -->
    <Button fx:id="advancedSettingsToggleButton" text="Cấu hình nâng cao"
            onAction="#onToggleAdvancedSettings"
            style="-fx-background-color: transparent; -fx-text-fill: #a5b4c8;"/>
    <VBox fx:id="advancedSettingsBox" visible="false" managed="false"
          spacing="10" alignment="CENTER">
        <Label text="Thiết lập Tracker / Peer" styleClass="subtitle"/>
        <HBox spacing="6" alignment="CENTER">
            <TextField fx:id="trackerHostField" promptText="Tracker IP / hostname" prefWidth="205"/>
            <TextField fx:id="trackerPortField" promptText="Port" prefWidth="95"/>
        </HBox>
        <CheckBox fx:id="trackerTlsCheckBox" text="Dùng TLS (yêu cầu truststore được cấu hình)"/>
        <TextField fx:id="trackerTrustStoreField" promptText="Đường dẫn TLS truststore"
                   maxWidth="320"/>
        <TextField fx:id="listeningPortField" promptText="Cổng lắng nghe Peer"
                   maxWidth="320"/>
        <HBox alignment="CENTER" spacing="8">
            <Button fx:id="saveTrackerButton" text="Lưu cấu hình" onAction="#onSaveTrackerSettings"/>
            <Button fx:id="diagnoseTrackerButton" text="Kiểm tra kết nối"
                    onAction="#onDiagnoseTracker"/>
        </HBox>
        <Button fx:id="importTrackerKeyButton" text="Nhập PUBLIC key Tracker (xác minh fingerprint)"
                onAction="#onImportTrackerPublicKey" maxWidth="320"/>
    </VBox>
        </VBox>
    </content>
</ScrollPane>
