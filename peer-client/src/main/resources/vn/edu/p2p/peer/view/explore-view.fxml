<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.edu.p2p.peer.share.ExploreController" styleClass="explore-root">
    <top>
        <VBox spacing="12" styleClass="explore-toolbar">
            <Label text="KHÁM PHÁ" styleClass="title"/>
            <Label text="Tìm và tải tệp hoặc thư mục P2P đang được chia sẻ" styleClass="subtitle"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="queryField" promptText="Tìm theo tên... để trống để khám phá" onAction="#onSearch" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="typeFilter" prefWidth="130"/>
                <ComboBox fx:id="sortCombo" prefWidth="165"/>
                <Button fx:id="searchButton" text="Tìm kiếm" onAction="#onSearch"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="resultsTable" editable="false" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="typeColumn" text="Loại" prefWidth="90" sortable="false"/>
                <TableColumn fx:id="nameColumn" text="Tên" prefWidth="255" sortable="false"/>
                <TableColumn fx:id="sizeColumn" text="Dung lượng" prefWidth="115" sortable="false"/>
                <TableColumn fx:id="dateColumn" text="Ngày đăng" prefWidth="155" sortable="false"/>
                <TableColumn fx:id="downloadsColumn" text="Đã tải" prefWidth="85" sortable="false"/>
                <TableColumn fx:id="sourceColumn" text="Nguồn" prefWidth="80" sortable="false"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="10" styleClass="explore-footer">
            <Label fx:id="detailsLabel" text="Chọn một kết quả để xem chi tiết." wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="downloadSelectedButton" text="Tải mục đã chọn" onAction="#onDownloadSelected" disable="true"/>
                <Button fx:id="loadMoreButton" text="Tải thêm" onAction="#onLoadMore"/>
                <Label fx:id="statusLabel" text="" wrapText="true" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
