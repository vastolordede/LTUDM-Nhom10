<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.p2p.peer.share.SearchController"
      spacing="12"
      styleClass="login-root">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="TÌM KIẾM FILE" styleClass="title"/>

    <HBox spacing="10">
        <TextField fx:id="queryField" promptText="Nhập tên file..." maxWidth="280"/>
        <Button fx:id="searchButton" text="Tìm" onAction="#onSearch"/>
    </HBox>

    <Label text="Kết quả:" styleClass="subtitle"/>
    <ListView fx:id="resultsListView" prefHeight="200"/>

    <Button fx:id="downloadSelectedButton" text="Tai file da chon" onAction="#onDownloadSelected" disable="true"/>

    <Label text="Nguồn của file đang chọn:" styleClass="subtitle"/>
    <Label fx:id="sourcesLabel" wrapText="true" maxWidth="420"/>

    <Label fx:id="statusLabel" wrapText="true" maxWidth="420" styleClass="status"/>
</VBox>
