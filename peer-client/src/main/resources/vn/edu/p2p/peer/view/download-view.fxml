<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="page-root" fx:controller="vn.edu.p2p.peer.transfer.DownloadController">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>

    <Label text="TẢI TỆP"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <!-- Selected File/Folder in Explore pre-fills verified metadata. -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Tệp đã chọn:"/>
        <TextField fx:id="fileNameField" promptText="Chọn tệp từ Khám phá" editable="false" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Khu vực chọn thư mục đích trên ổ cứng -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Thư mục lưu:"/>
        <TextField fx:id="outputDirField" editable="false" HBox.hgrow="ALWAYS"/>
        <Button fx:id="chooseDirButton" text="Chọn nơi lưu" onAction="#onChooseDirectory"/>
    </HBox>

    <!-- Các nút điều khiển Tải / Tạm dừng (Resume) -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button fx:id="startDownloadButton" text="Tải xuống / Tải tiếp" onAction="#onStartDownload"/>
        <Button fx:id="cancelDownloadButton" text="Tạm dừng / Hủy" onAction="#onCancelDownload" disable="true"/>
    </HBox>

    <!-- S16: Thanh tiến trình % và số lượng piece đã hoàn thành -->
    <VBox spacing="6.0">
        <ProgressBar fx:id="progressBar" progress="0.0" maxWidth="Infinity" prefHeight="22.0"/>
        <HBox spacing="20.0" alignment="CENTER_LEFT">
            <Label fx:id="progressPercentLabel" text="Tiến độ: 0.0%"/>
            <Label fx:id="downloadSpeedLabel" text="Tốc độ tải xuống: 0.0 KB/s"
                   style="-fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
            <Label fx:id="uploadSpeedLabel" text="Tốc độ tải lên: 0.0 KB/s"
                   style="-fx-font-weight: bold; -fx-text-fill: #059669;"/>
        </HBox>
    </VBox>

    <!-- Danh sách các Peer nguồn đang tham gia phiên tải -->
    <Label text="Nguồn tải và cách kết nối"/>
    <ListView fx:id="sourcesStatusListView" prefHeight="150.0" VBox.vgrow="ALWAYS"/>

    <Label fx:id="statusLabel" text="Sẵn sàng tải tệp." wrapText="true"/>
</VBox>